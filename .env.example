# Target CosyVoice 3 Foundation Model
MODEL_NAME=FunAudioLLM/Fun-CosyVoice3-0.5B-2512

# Project Directories
DATA_DIR=./data
MODEL_DIR=./models
RUNS_DIR=./runs

# Audio Configuration
SAMPLE_RATE=24000
SPEAKER_ID=itsme

# Transcription
WHISPER_MODEL=large-v3

# Hardware & Training
DEVICE=auto
CUDA_VISIBLE_DEVICES=0
BATCH_SIZE=4
GRADIENT_ACCUMULATION_STEPS=4
LEARNING_RATE=1e-4
NUM_EPOCHS=10
MIXED_PRECISION=true

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=secret-itsme-key-change-me
RATE_LIMIT_PER_MINUTE=60
MAX_TEXT_LENGTH=1000
